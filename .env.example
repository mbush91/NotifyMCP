# mqtt:// and tcp:// use port 1883 by default.
# mqtts:// and ssl:// use port 8883 by default and enable TLS.
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=notify/test

# Optional tuning
MQTT_KEEPALIVE_SECONDS=30
MQTT_PUBLISH_TIMEOUT_SECONDS=10

# HTTP notification endpoint (POST /notify). Disabled unless HTTP_ENABLED=true.
# Generate the hash once with:
#   python -c "import hashlib; print(hashlib.sha256(b'your-api-key-here').hexdigest())"
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
NOTIFY_API_KEY_HASH=
